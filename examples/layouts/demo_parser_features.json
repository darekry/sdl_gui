{
  "resources": {
    "fonts": [
      {
        "path": "assets/fonts/font.ttf",
        "size": 16
      },
      {
        "path": "assets/fonts/font.ttf",
        "size": 24
      }
    ]
  },
  "root": {
    "type": "TabControl",
    "x": 10,
    "y": 10,
    "width": 780,
    "height": 580,
    "tabHeight": 30,
    "tabs": [
      {
        "title": "Anchors",
        "children": [
          {
            "type": "Label",
            "text": "Top-Left Anchor (10px margin)",
            "anchorH": "left",
            "marginLeft": 10,
            "anchorV": "top",
            "marginTop": 10
          },
          {
            "type": "Label",
            "text": "Top-Right Anchor",
            "anchorH": "right",
            "marginRight": 10,
            "anchorV": "top",
            "marginTop": 10
          },
          {
            "type": "Label",
            "text": "Centered (0.5)",
            "anchorH": "center",
            "anchorV": "center"
          },
          {
            "type": "Button",
            "text": "Bottom-Right",
            "width": 100,
            "height": 30,
            "anchorH": "right",
            "marginRight": 10,
            "anchorV": "bottom",
            "marginBottom": 10
          },
          {
            "type": "Panel",
            "width": 200,
            "height": 40,
            "style": {
              "backgroundColor": "50,60,70,255",
              "borderColor": "100,110,120,255",
              "borderWidth": 1
            },
            "anchorH": "stretch",
            "marginLeft": 0,
            "marginRight": 0,
            "anchorV": "bottom",
            "marginBottom": 60
          },
          {
            "type": "Label",
            "text": "Bottom bar - stretched horizontally",
            "anchorH": "left",
            "marginLeft": 10,
            "anchorV": "bottom",
            "marginBottom": 75
          }
        ]
      },
      {
        "title": "RadioGroup",
        "children": [
          {
            "type": "Label",
            "text": "RadioGroup with options array:",
            "x": 20,
            "y": 20,
            "fontSize": 18
          },
          {
            "type": "RadioGroup",
            "x": 20,
            "y": 50,
            "width": 300,
            "height": 200,
            "optionSpacing": 35,
            "buttonX": 10,
            "labelX": 35,
            "startY": 10,
            "buttonSize": 18,
            "labelFontSize": 14,
            "options": [
              {
                "text": "First option"
              },
              {
                "text": "Second option (selected)",
                "selected": true
              },
              {
                "text": "Third option"
              },
              {
                "text": "Fourth option"
              }
            ],
            "styles": [
              {
                "state": "Normal",
                "backgroundColor": "40,44,52,255",
                "borderColor": "60,64,72,255",
                "borderWidth": 2
              }
            ]
          }
        ]
      },
      {
        "title": "ListView",
        "children": [
          {
            "type": "ListView",
            "rowHeight": 28,
            "selectedIndex": 0,
            "items": [
              {
                "text": "Anchored ListView fills tab"
              },
              {
                "text": "Resize window to test"
              },
              {
                "text": "Second item"
              },
              {
                "text": "Third item"
              },
              {
                "text": "Fourth item"
              },
              {
                "text": "Fifth item"
              },
              {
                "text": "Sixth item"
              },
              {
                "text": "Seventh item"
              },
              {
                "text": "Eighth item"
              },
              {
                "text": "Ninth item"
              },
              {
                "text": "Tenth item"
              }
            ],
            "anchorH": "stretch",
            "marginLeft": 10,
            "marginRight": 10,
            "anchorV": "stretch",
            "marginTop": 10,
            "marginBottom": 10
          }
        ]
      }
    ]
