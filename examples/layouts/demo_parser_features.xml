<?xml version="1.0" encoding="UTF-8"?>
<Layout>
  <Resources>
    <Font path="assets/fonts/font.ttf" size="16"/>
    <Font path="assets/fonts/font.ttf" size="24"/>
  </Resources>
  
  <TabControl x="10" y="10" width="780" height="580" tabHeight="30">
    <!-- Tab 1: Anchors demo -->
    <Tab title="Anchors">
      <Label text="Top-Left Anchor (10px margin)" anchorH="left" anchorV="top" marginLeft="10" marginTop="10"/>
      <Label text="Top-Right Anchor" anchorH="right" anchorV="top" marginRight="10" marginTop="10"/>
      <Label text="Centered" anchorH="center" anchorV="center"/>
      <Button text="Bottom-Right" width="100" height="30" anchorH="right" anchorV="bottom" marginRight="10" marginBottom="10"/>
      <Panel width="200" height="40" anchorH="stretch" anchorV="bottom" marginLeft="0" marginRight="0" marginBottom="60">
        <Style backgroundColor="50,60,70,255" borderColor="100,110,120,255" borderWidth="1"/>
      </Panel>
      <Label text="Bottom bar - stretched horizontally" anchorH="left" anchorV="bottom" marginLeft="10" marginBottom="75"/>
    </Tab>
    
    <!-- Tab 2: RadioGroup with options -->
    <Tab title="RadioGroup">
      <Label text="RadioGroup with options array:" x="20" y="20" fontSize="18"/>
      <RadioGroup x="20" y="50" width="300" height="200"
                  optionSpacing="35" buttonX="10" labelX="35" startY="10"
                  buttonSize="18" labelFontSize="14">
        <Style state="Normal" backgroundColor="40,44,52,255" 
               borderColor="60,64,72,255" borderWidth="2"/>
        <Option text="First option"/>
        <Option text="Second option (selected)" selected="true"/>
        <Option text="Third option"/>
        <Option text="Fourth option"/>
      </RadioGroup>
    </Tab>
    
    <!-- Tab 3: Anchored ListView -->
    <Tab title="ListView">
      <ListView anchorH="stretch" anchorV="stretch"
                marginLeft="10" marginTop="10" marginRight="10" marginBottom="10"
                rowHeight="28" selectedIndex="0">
        <Item text="Anchored ListView fills tab"/>
        <Item text="Resize window to test"/>
        <Item text="Second item"/>
        <Item text="Third item"/>
        <Item text="Fourth item"/>
        <Item text="Fifth item"/>
        <Item text="Sixth item"/>
        <Item text="Seventh item"/>
        <Item text="Eighth item"/>
        <Item text="Ninth item"/>
        <Item text="Tenth item"/>
      </ListView>
    </Tab>
  </TabControl>
</Layout>