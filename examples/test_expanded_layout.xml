<?xml version="1.0" encoding="UTF-8"?>
<Layout>
    <Resources>
        <Font path="assets/fonts/font.ttf" size="20" key="main_font" />
        <Texture path="assets/explosion.png" key="bonus_tex" />
    </Resources>

    <Panel id="root" x="0" y="0" width="800" height="600">
        <Style state="Normal" backgroundColor="50,50,50,255" />
        
        <Label id="title" x="200" y="20" text="Expanded XML Parser Test" fontSize="24">
            <Style state="Normal" textColor="255,255,255,255" />
        </Label>

        <TabControl x="50" y="70" width="700" height="600" tabHeight="40">
            <Tab title="Basic" >
                
                    <Button id="btn1" x="20" y="20" width="150" height="40">
                        <Style state="Normal" backgroundColor="#3498db" textColor="#ffffff" />
                        <Style state="Hover" backgroundColor="#2980b9" />
                        <Label x="0" y="0" text="Styled Button" />
                    </Button>
                    
                    <Checkbox x="20" y="80" checked="true" />
                    <Label x="60" y="80" text="Checked by default" />
                    
                    <RadioButton id="rb1" x="20" y="120" selected="true" />
                    <Label x="60" y="120" text="Option 1" />
                    
                    <Slider x="20" y="160" width="200" height="20" min="0" max="100" value="75" />
                
            </Tab>
            
            <Tab title="Text & Selection">
               
                    <TextInput x="20" y="20" width="250" height="35" text="Edit me..." />
                    
                    <TextArea x="20" y="70" width="400" height="150" text="This is a multiline text area.&#10;It supports word wrapping." wordWrap="true" fontPath="assets/fonts/font.ttf" />
                    
                    <ComboBox id="combo1" x="20" y="240" width="200" height="30">
                        <Item text="Selection A" />
                        <Item text="Selection B" />
                        <Item text="Selection C" />
                    </ComboBox>
               
            </Tab>

            <Tab title="Multimedia">
                
                    <AnimatedImage x="20" y="20" width="128" height="128" path="assets/explosion.png" frames="16" rows="1" fps="12" loop="true" />
                    <Canvas x="200" y="20" width="400" height="300" />
                
            </Tab>
        </TabControl>
    </Panel>
</Layout>
